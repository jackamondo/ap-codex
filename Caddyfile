# Caddyfile — serves the built Astro site as static files.
#
# `:{$PORT:80}` listens on the PORT env var that Railway injects, falling
# back to 80 for local Docker runs.
#
# Hashed asset bundles under `/_astro/*` are content-hashed by the build,
# so we can cache them effectively forever. Everything else (HTML pages,
# the favicon) gets a short cache so deploys roll out promptly.

:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@unhashed not path /_astro/*
	header @unhashed Cache-Control "public, max-age=300, must-revalidate"
}
