---
// CommitList — the "Commit history" block on a snippet page.
//
// Each row is a 4-column grid: sha pill | message | author | relative date.
// Conventional-commit prefixes (`feat:`, `fix:`, `docs:`, `a11y:`) are
// stripped from the message and rendered as a small colored pill so the
// type of change reads at a glance.

import { SITE_CONFIG } from '../lib/config';
import { formatRelative } from '../lib/format';
import type { Commit } from '../lib/commits';

interface Props {
  commits: Commit[];
  /** Path to the source `.md` inside `zd-codex/content/` (e.g. `header/foo.md`). */
  sourcePath: string;
}

const { commits, sourcePath } = Astro.props;

// Only these prefixes get a colored pill; anything else stays in the message
// body so we don't misclassify random prefixes (like `chore` or a typo'd `fxi`).
const KNOWN_PREFIXES = ['feat', 'fix', 'docs', 'a11y'] as const;
type KnownPrefix = (typeof KNOWN_PREFIXES)[number];

function splitPrefix(message: string): { prefix: KnownPrefix | null; rest: string } {
  const match = message.match(/^([a-z0-9]+):\s*(.*)$/i);
  if (!match) return { prefix: null, rest: message };
  const candidate = match[1].toLowerCase() as KnownPrefix;
  return KNOWN_PREFIXES.includes(candidate)
    ? { prefix: candidate, rest: match[2] }
    : { prefix: null, rest: message };
}

const sourceUrl = `${SITE_CONFIG.repoUrl}/blob/main/content/${sourcePath}`;
---

<section class="section-block" id="commit-history">
  <h2 class="section-block-h">
    Commit history
    <span class="pill">{commits.length} commit{commits.length === 1 ? '' : 's'}</span>
  </h2>

  <ul class="commits">
    {commits.map((commit) => {
      const { prefix, rest } = splitPrefix(commit.message);
      return (
        <li class="commit">
          <a
            class="commit-sha"
            href={`${SITE_CONFIG.repoUrl}/commit/${commit.sha}`}
            target="_blank"
            rel="noreferrer noopener"
          >
            {commit.sha}
          </a>
          <span class="commit-message">
            {prefix && (
              <span class:list={['commit-message-prefix', prefix]}>{prefix}</span>
            )}
            {rest}
          </span>
          <span class="commit-date">{formatRelative(commit.date)}</span>
        </li>
      );
    })}
  </ul>

  <div class="commit-source">
    <span>content/{sourcePath}</span>
    <a
      class="commit-source-link"
      href={sourceUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      View on GitHub
      <svg
        width="11" height="11" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7M9 7h8v8" />
      </svg>
    </a>
  </div>
</section>
